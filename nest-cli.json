{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
     "watchOptions": {
      "watchFile": "poll",
      "watchDirectory": "poll",
      "fallbackPolling": "dynamicPriority",
      "poll": 1000
    }
  }
}


